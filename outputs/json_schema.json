{
    "title": "Review",
    "type": "object",
    "properties": {
        "key_themes": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "write down all the key themes discussed in the review in a list"
        },
        "summary": {
            "type": "string",
            "description": "summarize the whole review in 2-3 lines"
        },
        "sentiment": {
            "type": "string",
            "enum": ["pos", "neg", "neut"],
            "description": "return sentiment of the review as pos, neg or neut"
        },
        "pros": {
            "type": ["array", "null"],
            "items": {
                "type": "string"
            },
            "description": "find all the pros from the review"
        },
        "cons": {
            "type": ["array", "null"],
            "items": {
                "type": "string"
            },
            "description": "find all the cons from the review"
        },
        "name": {
            "type": ["string", "null"],
            "description": "name of the Reviewer"
        }
    },
    "required": ["key_themes", "summary", "sentiment"]
}